{
  "manifest_version": 3,
  "minimum_chrome_version": "102",
  "name": "grokslut session bridge",
  "version": "0.1.0",
  "description": "Sends your current Grok browser session to the local grokslut exporter.",
  "permissions": ["cookies", "storage", "webRequest"],
  "host_permissions": [
    "https://grok.com/*",
    "https://*.grok.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Connect grokslut",
    "default_popup": "popup.html"
  }
}
