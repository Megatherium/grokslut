{
  "manifest_version": 3,
  "minimum_chrome_version": "102",
  "name": "grokslut session bridge",
  "version": "0.1.0",
  "description": "Sends your current Grok or Gemini browser session to the local grokslut exporter and manages queued downloads.",
  "permissions": ["alarms", "cookies", "storage", "webRequest"],
  "host_permissions": [
    "https://grok.com/*",
    "https://*.grok.com/*",
    "https://gemini.google.com/*",
    "https://*.google.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://127.0.0.1/*", "http://localhost/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Connect grokslut",
    "default_popup": "popup.html"
  }
}
